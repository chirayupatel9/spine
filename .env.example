# Where your music lives on the host (mounted read-only into the container)
MUSIC_PATH=/path/to/your/music

# The URL you open Album Viewer at. Spotify only accepts https:// or http://127.0.0.1 redirect URIs.
#   local testing:  http://127.0.0.1:8000
#   hosted:         https://albums.yourdomain.com
PUBLIC_URL=http://127.0.0.1:8000

# Sign-in is always required. Choose a password here (10+ characters), or leave it empty and one is
# generated on first start: it's printed in the log and saved in data/password.txt.
APP_PASSWORD=

# The container runs as this user and group. They must own the ./data folder (run `id` to see yours).
PUID=1000
PGID=1000

# Behind a reverse proxy or tunnel (Caddy, nginx, Cloudflare Tunnel), set this to the proxy's
# address, or the Docker network it runs on, so sign-in limits see each visitor's real address.
# Never use *: the app would then believe whatever address a visitor writes into X-Forwarded-For.
# FORWARDED_ALLOW_IPS=172.31.240.0/24

# From https://developer.spotify.com/dashboard  (redirect URI = PUBLIC_URL + /auth/spotify/callback)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Look up missing covers online (iTunes Search, then MusicBrainz / Cover Art Archive)
ART_LOOKUP_ONLINE=1

# Rescan the music folder and re-sync Spotify every N minutes (0 = startup + manual only)
RESCAN_MINUTES=60

# Largest cover image you can upload, in MB
MAX_UPLOAD_MB=15

# Android app (Trusted Web Activity). Lets Android open this site full screen in your app, without
# a browser bar, by answering at /.well-known/assetlinks.json. List the SHA-256 fingerprints of
# Google Play's app-signing key and of your upload key, comma-separated.
# ANDROID_PACKAGE=com.example.albumviewer
# ANDROID_CERT_SHA256=AB:CD:...,12:34:...
