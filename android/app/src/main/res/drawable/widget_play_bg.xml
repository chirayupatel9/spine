<?xml version="1.0" encoding="utf-8"?>
<!-- play / pause: a white disc, a touch darker while pressed -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval"><solid android:color="#D9FFFFFF" /></shape>
    </item>
    <item>
        <shape android:shape="oval"><solid android:color="#EBFFFFFF" /></shape>
    </item>
</selector>
