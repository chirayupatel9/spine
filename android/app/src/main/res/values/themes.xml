<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AlbumViewer" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Shown for the moment it takes to start: dark, with the icon, straight into the app. -->
    <style name="Theme.AlbumViewer.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/bg</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.AlbumViewer</item>
    </style>
</resources>
